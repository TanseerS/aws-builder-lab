# --- macOS ---
.DS_Store
._*

# --- Terraform ---
# State can contain resource metadata; never commit it.
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
**/.terraform/
**/.terraform/*
.terraform.lock.hcl
*.tfvars
*.tfvars.json
!example.tfvars
.terraformrc
terraform.rc
*.tfplan
*.tfplan.*
tfplan
plan.out

# Lambda zips built by the archive provider during apply.
terraform/.build/

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
credentials
aws-credentials*

# --- Editors ---
.vscode/
.idea/
*.swp
*~

# --- Logs ---
*.log
tmp/
